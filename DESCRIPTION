Package: MATH4753
Type: Package
Title: Statistical Tools for Inference and Simulation
Version: 0.1.0
Authors@R: 
    person(
      given = "Nabil", 
      family = "Ahmed",
      email = "nabila@ou.edu",
      role = c("aut", "cre")
